# --- Database (same details you already use) ---
PGHOST=your-database-server
PGPORT=5432
PGDATABASE=postgres
PGUSER=your_user
PGPASSWORD=your_password
PGSSLMODE=require

# --- Store settings ---
PORT=3000

# Password for the admin page at http://localhost:3000/admin  (choose your own, keep it private)
ADMIN_PASSWORD=change-this-password

# Currency shown on prices
CURRENCY=GH₵

# Optional: the most an employee can take on credit in a single order. 0 or empty = no limit.
MAX_ORDER_TOTAL=0
